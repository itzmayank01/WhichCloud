# Copy to .env.local and fill in. Everything here is read at build time as
# well as at runtime, so a change needs a redeploy, not just a restart.

# ── the API ──
# Where the pricing engine is. Locally this is the uvicorn on 8010; deployed,
# it is the backend's public URL. WITHOUT IT a deployed frontend calls
# 127.0.0.1 -- the VISITOR's own machine -- and every request fails in a way
# that looks like the engine is down rather than unconfigured.
# No trailing slash.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010

# Used for canonical URLs and social cards. Set to the real origin in
# production, e.g. https://whichcloud.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Clerk (authentication) ──
# dashboard.clerk.com -> your app -> API keys.
#
# A pk_test/sk_test pair is a DEVELOPMENT instance: it works on localhost and
# on preview URLs, and it is not meant to serve a real domain. Create a
# production instance for that and use its pk_live/sk_live pair -- the test
# keys will authenticate people, then behave oddly in ways that look like
# application bugs.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's own pages live in this app. These match app/sign-in and
# app/sign-up and should not need changing.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where someone lands after signing in when they did not arrive from a deep
# link. The workspace, not the landing page: they have already read the
# argument for the product. Also set on ClerkProvider in app/layout.tsx, so
# this file staying unset does not silently send everyone home.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
