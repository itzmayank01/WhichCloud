# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and is the one file a new
# contributor reads to learn what has to be configured. `.env*` was swallowing
# it, so it had never been committed: it sat on one machine describing Auth.js
# long after the app moved to Clerk, and nobody cloning the repo ever saw it
# to notice.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
