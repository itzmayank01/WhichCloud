# Copy to .env and fill in, or set these in your host's dashboard.

# ── data stores ──
# Postgres must have the pgvector extension available (the local compose file
# uses the pgvector/pgvector image for exactly this reason). Most managed
# providers offer it as an extension you enable once.
WHICHCLOUD_DSN=postgresql://whichcloud:whichcloud_dev@localhost:5432/whichcloud

# Price lookups are cached here so the engine never re-queries a provider
# mid-request. The service runs without it -- slower, and every lookup hits
# Postgres.
WHICHCLOUD_REDIS_URL=redis://localhost:6379/0

# ── who may call this API ──
# Comma-separated origins, no trailing slashes. localhost is always allowed,
# so this is only needed once a deployed frontend exists.
#   WHICHCLOUD_ALLOWED_ORIGINS=https://whichcloud.vercel.app
WHICHCLOUD_ALLOWED_ORIGINS=

# Vercel gives every preview deployment its own hostname, so listing them
# individually would mean editing the variable per deploy. Anchor the pattern
# at both ends or it will match any domain that merely contains the name:
#   WHICHCLOUD_ALLOWED_ORIGIN_REGEX=^https://whichcloud-[a-z0-9-]+\.vercel\.app$
WHICHCLOUD_ALLOWED_ORIGIN_REGEX=

# ── who may call the per-person routes ──
# Clerk's public signing keys for your instance. Without it, every route that
# touches somebody's saved work refuses -- deliberately: a default here would
# mean a misconfigured deployment silently verifying nothing, which looks
# exactly like everything working.
#   https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# Optional, and worth setting. Clerk puts the calling origin in `azp`; a token
# minted for a different app on the same instance verifies cryptographically
# and still does not belong here. Comma-separated.
CLERK_AUTHORIZED_PARTIES=

# Interim lockdown for FinOps Live and the cloud connection routes: they run
# against ONE set of AWS credentials on this server (see
# connections/aws_live.py), not per-tenant ones, so every signed-in user
# currently reaches the same real account. Real per-tenant isolation
# (AssumeRole + the cloud_connections table) exists but isn't wired in yet --
# until it is, only Clerk user ids listed here (comma-separated) can reach
# those routes. Deliberately has no default and fails closed: empty means
# nobody gets through, not everybody.
WHICHCLOUD_FINOPS_OWNERS=

# ── language models ──
# Only plain-English intake (/describe) and the advisor (/advise) need these.
# Pricing, recommendations and diagrams run without any key at all.
#
# Gemini has a free tier: aistudio.google.com/apikey
# Extra keys rotate as _2 .. _9 when one is out of quota for the day.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Reader preference, most accurate first. Leave unset for the default.
#   WHICHCLOUD_READER_ORDER=gemini,groq,anthropic
WHICHCLOUD_READER_ORDER=

# ── GitHub App (sign-in-scoped repo listing, /api/github/*) ──
# A GitHub App, not an OAuth App: the user picks which repos it can see at
# install time, and it reads Contents + Metadata only. Create one at
# github.com/settings/apps/new. This is separate from the AWS/Azure/GCP
# connection routes above and from the PAT-based Terraform scan under
# /api/connections/{setup,verify} with provider=github -- that one prices
# Terraform a user already wrote; this one lists repos to analyse from
# scratch.
#
# Settings this app needs:
#   Permissions: Contents = Read-only, Metadata = Read-only. Nothing else.
#   Enable "Request user authorization (OAuth) during installation".
#   Callback URL:  {backend URL}/api/github/oauth/callback
#   Webhook URL:   {backend URL}/api/github/webhook
#   Webhook events: installation, installation_repositories
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# The App's private key (Generate a private key, on the App's settings page),
# PEM format, newlines kept literal or escaped as \n depending on how your
# host's dashboard accepts multi-line values.
GITHUB_APP_PRIVATE_KEY=

# Set when creating the webhook. Every webhook delivery is verified against
# this before its payload is trusted; without it the endpoint refuses every
# delivery rather than accepting an unsigned one.
GITHUB_WEBHOOK_SECRET=

# Where to send the browser back to after the GitHub install/authorize
# redirect completes (success or failure). No trailing slash.
WHICHCLOUD_FRONTEND_URL=http://localhost:3000
