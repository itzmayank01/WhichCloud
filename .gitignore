.pytest_cache/

# Node
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo

# Vercel project link (created at repo root when deploying via `vercel` CLI
# from the root instead of frontend/ -- see render.yaml's sibling comment
# about dockerContext for why root-level deploys matter here)
.vercel/
*.log

# Env & secrets  ── NEVER COMMIT
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
.terraform.lock.hcl

# Infracost
.infracost/
infracost.json

# Data / generated
*.db
*.sqlite3
pricing-data/
generated/
*.png
!docs/**/*.png
# Vendored AWS architecture icons (scripts/fetch_aws_icons.py) -- these are
# committed application assets the architecture diagram renders at runtime,
# not generated/cached data. The blanket *.png rule above silently excluded
# all 86 of them, so the diagram fell back to a generic glyph for every node
# on any machine that didn't happen to have them already on disk locally.
!frontend/public/icons/**/*.png

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# venv
.venv/

# cached price catalogs (300MB+)
.cache/
*.json.part

# regression harness: append-only price-drift log, local to this checkout
backend/tests/harness_history.jsonl
